const express = require('express');
const cors = require('cors');
const { Pool } = require('pg');
const stripe = require('stripe')(process.env.STRIPE_SECRET_KEY);
const dotenv = require('dotenv');

// Caricamento variabili d'ambiente
dotenv.config();

const app = express();

// Connessione reale al Database
const pool = new Pool({
  connectionString: process.env.DATABASE_URL,
});

// IL WEBHOOK DI STRIPE DEVE ESSERE PRIMA DEL PARSER JSON
// Questo serve perché Stripe richiede il corpo della richiesta "grezzo" per verificare la sicurezza
app.post('/api/webhooks/stripe', express.raw({type: 'application/json'}), async (req, res) => {
  const sig = req.headers['stripe-signature'];
  let event;

  try {
    event = stripe.webhooks.constructEvent(req.body, sig, process.env.STRIPE_WEBHOOK_SECRET);
  } catch (err) {
    console.error('Errore validazione Webhook:', err.message);
    return res.status(400).send(`Webhook Error: ${err.message}`);
  }

  // Gestione degli stati reali del pagamento
  if (event.type === 'payment_intent.succeeded') {
    const paymentIntent = event.data.object;
    
    // Aggiorniamo il database in modo sicuro dal server
    try {
      await pool.query(
        'UPDATE bookings SET payment_status = $1 WHERE stripe_payment_intent_id = $2',
        ['paid', paymentIntent.id]
      );
      console.log('Pagamento confermato e prenotazione aggiornata nel database.');
      // Qui in seguito inseriremo il codice per inviare l'email reale
    } catch (dbError) {
      console.error('Errore aggiornamento database:', dbError);
    }
  }

  if (event.type === 'payment_intent.payment_failed') {
    const paymentIntent = event.data.object;
    try {
      await pool.query(
        'UPDATE bookings SET payment_status = $1 WHERE stripe_payment_intent_id = $2',
        ['failed', paymentIntent.id]
      );
      console.log('Pagamento fallito registrato.');
    } catch (dbError) {
      console.error('Errore aggiornamento database:', dbError);
    }
  }

  // Risposta obbligatoria per far sapere a Stripe che abbiamo ricevuto il messaggio
  res.json({received: true});
});

// Configurazione di base per tutte le altre rotte
app.use(cors({ origin: process.env.CLIENT_URL }));
app.use(express.json()); // Permette al server di leggere i dati in formato JSON

// Avvio del Server Reale
const PORT = process.env.PORT || 5000;
app.listen(PORT, () => {
  console.log(`Server Meet & Play in esecuzione sulla porta ${PORT}`);
});
