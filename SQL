-- Estensione per generare ID unici e sicuri
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- Tabella Utenti
CREATE TABLE users (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    email VARCHAR(255) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    full_name VARCHAR(255) NOT NULL,
    role VARCHAR(50) DEFAULT 'user' CHECK (role IN ('user', 'admin')),
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- Tabella Eventi
CREATE TABLE events (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    title VARCHAR(255) NOT NULL,
    image_url TEXT,
    color VARCHAR(50) DEFAULT '#7C93E3',
    description TEXT NOT NULL,
    event_date DATE NOT NULL,
    start_time TIME NOT NULL,
    end_time TIME NOT NULL,
    location VARCHAR(255) NOT NULL,
    capacity INTEGER NOT NULL,
    price DECIMAL(10, 2) NOT NULL DEFAULT 0.00,
    is_paid BOOLEAN DEFAULT false,
    status VARCHAR(50) DEFAULT 'disponibile' CHECK (status IN ('disponibile', 'quasi completo', 'completo', 'chiuso', 'annullato')),
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- Tabella Giochi
CREATE TABLE games (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    name VARCHAR(255) NOT NULL,
    image_url TEXT,
    category VARCHAR(100) NOT NULL,
    min_players INTEGER NOT NULL,
    max_players INTEGER NOT NULL,
    duration_minutes INTEGER NOT NULL,
    description TEXT,
    status VARCHAR(50) DEFAULT 'disponibile' CHECK (status IN ('disponibile', 'in uso', 'manutenzione'))
);

-- Tabella Prenotazioni
CREATE TABLE bookings (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    user_id UUID REFERENCES users(id) ON DELETE CASCADE,
    event_id UUID REFERENCES events(id) ON DELETE CASCADE,
    game_id UUID REFERENCES games(id) ON DELETE SET NULL,
    participants_count INTEGER NOT NULL DEFAULT 1,
    total_amount DECIMAL(10, 2) NOT NULL,
    payment_status VARCHAR(50) DEFAULT 'pending' CHECK (payment_status IN ('pending', 'paid', 'failed', 'cancelled', 'refunded')),
    stripe_payment_intent_id VARCHAR(255) UNIQUE,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- Tabella Impostazioni Admin
CREATE TABLE settings (
    id SERIAL PRIMARY KEY,
    site_name VARCHAR(255) DEFAULT 'Meet & Play',
    association_name VARCHAR(255) DEFAULT 'Materia Creativa (MC)',
    contact_email VARCHAR(255) DEFAULT 'meet.play@libero.it',
    contact_phone VARCHAR(50) DEFAULT '+39 349 870 2940',
    whatsapp_url TEXT DEFAULT 'https://chat.whatsapp.com/FkETCDqE1IvGSAQYGl7Afb',
    instagram_url TEXT DEFAULT 'https://www.instagram.com/meet.play_mc?stkn=MjI2cXhkd2N0anVo',
    game_buffer_minutes INTEGER DEFAULT 15
);
